 }catch(e){return {}}
}
function saveCart(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify(cart))}catch(e){showToast('Browser storage is unavailable; cart may not persist.')}}
function money(n){return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n)}
function escapeHtml(value){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderFilters(){
 const cats=['All',...new Set(products.map(p=>p.category))];
 document.getElementById('filters').innerHTML=cats.map(c=>`<button type="button" class="filter ${c===activeCategory?'active':''}" aria-pressed="${c===activeCategory}" onclick="setCategory('${escapeHtml(c)}')">${escapeHtml(c)}</button>`).join('');
}
function setCategory(c){activeCategory=c;renderFilters();renderProducts()}
function renderProducts(){
 const shown=products.filter(p=>activeCategory==='All'||p.category===activeCategory);
 document.getElementById('productGrid').innerHTML=shown.map(p=>`
 <article class="product-card">
  <div class="product-image-wrap"><img class="product-image" src="${escapeHtml(p.image)}" alt="${escapeHtml(p.name)}" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 400%22%3E%3Crect width=%22400%22 height=%22400%22 fill=%22%23e8efea%22/%3E%3Ctext x=%22200%22 y=%22195%22 text-anchor=%22middle%22 font-size=%2260%22%3E%F0%9F%93%A6%3C/text%3E%3Ctext x=%22200%22 y=%22245%22 text-anchor=%22middle%22 font-family=%22Arial%22 font-size=%2218%22 fill=%22%23123b35%22%3EProduct image%3C/text%3E%3C/svg%3E'">${p.sample?'<span class="product-badge">Sample photo</span>':''}</div>
  <div class="product-info"><span class="product-category">${escapeHtml(p.category)}</span><h3>${escapeHtml(p.name)}</h3><p class="product-desc">${escapeHtml(p.description)}</p><div class="product-bottom"><span class="price">${money(p.price)}</span><button class="add-btn" type="button" onclick="addToCart('${p.id}')">＋ Add</button></div></div>
 </article>`).join('');
}
function totalItems(){return Object.values(cart).reduce((a,b)=>a+b,0)}
function cartTotal(){return products.reduce((sum,p)=>sum+p.price*(cart[p.id]||0),0)}
function updateCounts(){
 document.getElementById('navCount').textContent=totalItems();
 document.getElementById('floatCount').textContent=totalItems();
 document.getElementById('floatCount').setAttribute('aria-label',`${totalItems()} items in cart`);
}
function showToast(msg){
 const el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300);
}
function addToCart(id){
 if(!products.some(p=>p.id===id))return;
 if((cart[id]||0)>=99){showToast('Maximum quantity is 99 per product.');return}
 cart[id]=(cart[id]||0)+1;saveCart();updateCounts();showToast('Added to your cart ✓');
 const btn=document.querySelector(`button[onclick="addToCart('${id}')"]`);
 if(btn){const old=btn.textContent;btn.textContent='✓ Added';setTimeout(()=>{if(btn.isConnected)btn.textContent=old},900)}
}
function changeQty(id,delta){
 const next=(cart[id]||0)+delta;
 if(next<=0)delete cart[id];else cart[id]=Math.min(99,next);
 saveCart();updateCounts();renderCart();
}
function removeItem(id){delete cart[id];saveCart();updateCounts();renderCart();showToast('Item removed from cart.')}
function openCart(){
 document.getElementById('cartModal').classList.add('open');document.body.style.overflow='hidden';
 document.getElementById('checkoutPanel').classList.remove('show');document.getElementById('successPanel').classList.remove('show');
 renderCart();
}
function closeCart(){document.getElementById('cartModal').classList.remove('open');document.body.style.overflow=''}
function backdropClose(e){if(e.target===document.getElementById('cartModal'))closeCart()}
function renderCart(){
 const content=document.getElementById('cartContent');
 const items=products.filter(p=>cart[p.id]);
 if(!items.length){
  content.innerHTML='<div class="cart-empty"><div class="big">🛍️</div><h3>Your cart is empty</h3><p>Find something useful for your everyday tech.</p><button class="btn btn-primary" type="button" onclick="closeCart();document.getElementById(\\'products\\').scrollIntoView({behavior:\\'smooth\\'})">Browse products</button></div>';
  document.getElementById('checkoutPanel').classList.remove('show');return;
 }
 content.innerHTML='<div class="cart-list">'+items.map(p=>`<div class="cart-line"><img src="${escapeHtml(p.image)}" alt="" loading="lazy"><div><h3>${escapeHtml(p.name)}</h3><small>${money(p.price)} each</small><div class="qty"><button type="button" aria-label="Decrease ${escapeHtml(p.name)} quantity" onclick="changeQty('${p.id}',-1)">−</button><span>${cart[p.id]}</span><button type="button" aria-label="Increase ${escapeHtml(p.name)} quantity" onclick="changeQty('${p.id}',1)">+</button></div></div><div class="line-total">${money(p.price*cart[p.id])}<button type="button" class="remove-btn" onclick="removeItem('${p.id}')">Remove</button></div></div>`).join('')+'</div><div class="cart-summary"><span>Grand total</span><strong>'+money(cartTotal())+'</strong></div><p class="cart-note">This is an order request, not a payment. The shop will confirm product availability, delivery, and final arrangements.</p><button type="button" class="btn checkout-btn" onclick="showCheckout()">Continue to details →</button>';
}
function showCheckout(){
 if(!totalItems()){showToast('Add a product to your cart first.');return}
 document.getElementById('checkoutPanel').classList.add('show');
 document.getElementById('checkoutPanel').scrollIntoView({behavior:'smooth',block:'nearest'});
 prepareOrderFields();
}
function buildOrderSummary(){
 const lines=products.filter(p=>cart[p.id]).map(p=>`${p.name} | Qty: ${cart[p.id]} | Unit price: ${money(p.price)} | Subtotal: ${money(p.price*cart[p.id])}`);
 return `${SHOP_NAME} — NEW ORDER REQUEST\n\nITEMS:\n${lines.join('\n')}\n\nGRAND TOTAL: ${money(cartTotal())}\n\nThis is an order request only. No online payment was collected. Please contact the customer to confirm stock, delivery, and final arrangements.`;
}
function prepareOrderFields(){
 document.getElementById('orderSummaryField').value=buildOrderSummary();
 document.getElementById('grandTotalField').value=money(cartTotal());
 document.getElementById('itemsJsonField').value=JSON.stringify(products.filter(p=>cart[p.id]).map(p=>({id:p.id,name:p.name,quantity:cart[p.id],unitPrice:p.price,subtotal:p.price*cart[p.id]})));
}
function setSubmitting(isSubmitting){
 const btn=document.getElementById('submitOrderBtn');btn.disabled=isSubmitting;btn.textContent=isSubmitting?'Sending order…':'Place Order Request';
}
document.getElementById('orderForm').addEventListener('submit',async function(e){
 e.preventDefault();
 if(!totalItems()){showToast('Your cart is empty.');return}
 if(!this.reportValidity())return;
 prepareOrderFields();setSubmitting(true);
 const formData=new FormData(this);
 // Formspree receives customer fields and a readable precompiled order summary.
 try{
  const response=await fetch(FORMSPREE_ENDPOINT,{method:'POST',body:formData,headers:{'Accept':'application/json'}});
  let data={};try{data=await response.json()}catch(_){}
  if(!response.ok)throw new Error(data.errors?.map(x=>x.message).join(', ')||'The order could not be sent.');
  cart={};saveCart();updateCounts();this.reset();document.getElementById('checkoutPanel').classList.remove('show');document.getElementById('cartContent').innerHTML='';document.getElementById('successPanel').classList.add('show');
  const name=document.getElementById('customerName').value.trim();
  const message=`Hi ${SHOP_NAME}, I have just placed an order request on your website. Please help me confirm it.`;
  document.getElementById('successWhatsApp').href=`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
  // Keep the cart modal open to display confirmation.
 }catch(err){
  showToast('Could not send order. Please try WhatsApp instead.');
  document.getElementById('submitNote').textContent='We could not submit the form just now. Please check your internet connection and try again, or contact the shop on WhatsApp.';
  console.error('Formspree order submission failed:',err);
 }finally{setSubmitting(false)}
});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeCart()});
document.getElementById('year').textContent=new Date().getFullYear();
renderFilters();renderProducts();updateCounts();
</script>
</body>
</html>
